# Production Environment Configuration
# Copy this file and modify as needed

# Database Configuration (External)
DB_HOST=your-db-host.com
DB_PORT=5432
DB_USER=auth_service_user
DB_PASSWORD=your-secure-password
DB_NAME=auth_service_prod
DB_SSL_MODE=require
USE_EXTERNAL_DB=true

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_MODE=release
FRONTEND_PORT=3000

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET_KEY=your-super-secret-jwt-key-minimum-64-characters-long
JWT_ACCESS_TOKEN_TTL=15
JWT_REFRESH_TOKEN_TTL=10080

# Nginx Configuration
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=/var/log/auth-service/auth-service.log
LOG_FORMAT=json
LOG_MAX_SIZE=200
LOG_MAX_BACKUPS=10
LOG_MAX_AGE=90