# Logging Configuration Examples
# Copy and modify these examples as needed

# Example 1: Console logging (development)
LOG_LEVEL=debug
LOG_FILE=""
LOG_FORMAT=text
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=5
LOG_MAX_AGE=30

# Example 2: File logging (production)
# LOG_LEVEL=info
# LOG_FILE=/var/log/auth-service/auth-service.log
# LOG_FORMAT=json
# LOG_MAX_SIZE=200
# LOG_MAX_BACKUPS=10
# LOG_MAX_AGE=90

# Example 3: Custom log location
# LOG_LEVEL=warn
# LOG_FILE=/opt/logs/auth/service.log
# LOG_FORMAT=json
# LOG_MAX_SIZE=50
# LOG_MAX_BACKUPS=3
# LOG_MAX_AGE=14

# Example 4: Debug logging with large files
# LOG_LEVEL=debug
# LOG_FILE=/tmp/auth-debug.log
# LOG_FORMAT=text
# LOG_MAX_SIZE=500
# LOG_MAX_BACKUPS=2
# LOG_MAX_AGE=7

# Log Level Options:
# - debug: Most verbose, includes all debug information
# - info:  General information about service operation
# - warn:  Warning messages for potentially harmful situations
# - error: Only error messages

# Log Format Options:
# - json: Structured JSON format (recommended for production)
# - text: Human-readable text format (good for development)

# Log Rotation:
# - LOG_MAX_SIZE: Maximum size of log file in MB before rotation
# - LOG_MAX_BACKUPS: Number of old log files to keep
# - LOG_MAX_AGE: Maximum age of log files in days