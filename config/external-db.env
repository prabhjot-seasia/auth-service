# External Database Configuration Example
# For use with existing PostgreSQL instances

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password
DB_NAME=auth_service
DB_SSL_MODE=disable
USE_EXTERNAL_DB=true

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_MODE=development
FRONTEND_PORT=3001

# JWT Configuration
JWT_SECRET_KEY=external-db-secret-key
JWT_ACCESS_TOKEN_TTL=15
JWT_REFRESH_TOKEN_TTL=10080

# Skip docker database
DB_PORT_EXTERNAL=5433

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=/var/log/auth-service/auth-service.log
LOG_FORMAT=json
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=5
LOG_MAX_AGE=30